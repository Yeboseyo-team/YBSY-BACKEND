# 복사해서 .env.local 로 만들고 값을 채워주세요: cp .env.example .env.local
# 실제 값은 팀 채널에서 공유받기 (절대 커밋 금지)

# Supabase 프로젝트 URL
VITE_SUPABASE_URL=

# Supabase publishable 키(sb_publishable_...) 또는 예전 anon 키 - 프론트엔드에서 써도 되는 공개 키
# 대시보드 > Project Settings > API Keys 에서 복사
# ⚠️ service_role / secret 키는 여기에 넣지 마세요
VITE_SUPABASE_PUBLISHABLE_KEY=
